# Postgres for both dev and prod (Payload's official db-postgres adapter — no MySQL).
# Local dev: point at a local Postgres role/db. Production (DigitalOcean VPS): that box's
# Postgres connection string, or a managed Postgres add-on.
DATABASE_URI=postgres://structured_advent:dev_password@localhost:5432/structured_advent_dev

# Long random string — used to sign Payload's JWTs. Generate with:
# openssl rand -base64 32
PAYLOAD_SECRET=generate-with-openssl-rand-base64-32

# Public site URL (used for sitemap.xml, robots.txt, canonical URLs)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudinary — Media collection storage + image CDN (src/lib/cloudinaryStorage.ts).
# Find these in the Cloudinary console (Dashboard tab). Falls back to local disk
# storage if any of the three are unset — safe to leave blank for local dev.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
